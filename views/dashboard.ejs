<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Dashboard — Bankify</title>
  <style>
    .page-wrap {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    .dash-content {
      flex: 1;
      padding: 110px 24px 60px;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }

    /* ── Welcome Banner ── */
    .welcome-banner {
      background: rgba(123,47,247,0.06);
      border: 1px solid rgba(123,47,247,0.12);
      border-radius: var(--radius-xl);
      padding: 36px 40px;
      margin-bottom: 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      animation: fadeInUp 0.5s ease-out both;
    }
    .welcome-text h1 {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .welcome-text p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    /* ── Section Header ── */
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .section-header h2 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    /* ── Account Cards ── */
    .accounts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
      margin-bottom: 48px;
    }
    .account-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: var(--radius-xl);
      padding: 28px 28px 24px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
      animation: fadeInUp 0.5s ease-out both;
    }
    .account-card:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(255,255,255,0.12);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.3), var(--shadow-glow);
    }
    .account-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .account-id {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-family: monospace;
      background: rgba(255,255,255,0.05);
      padding: 4px 10px;
      border-radius: 6px;
      letter-spacing: 0.02em;
    }
    .account-status {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 5px 12px;
      border-radius: var(--radius-full);
    }
    .status-ACTIVE {
      background: rgba(0,230,118,0.12);
      color: #69f0ae;
      border: 1px solid rgba(0,230,118,0.25);
    }
    .status-FROZEN {
      background: rgba(255,215,64,0.12);
      color: #ffd740;
      border: 1px solid rgba(255,215,64,0.25);
    }
    .status-CLOSED {
      background: rgba(255,82,82,0.12);
      color: #ff8a80;
      border: 1px solid rgba(255,82,82,0.25);
    }
    .account-balance {
      margin-bottom: 16px;
    }
    .balance-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .balance-value {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }
    .balance-positive { color: #69f0ae; }
    .balance-zero { color: var(--text-secondary); }
    .balance-negative { color: #ff8a80; }
    .account-currency {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 500;
    }
    .account-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: var(--accent-gradient);
      opacity: 0;
      transition: var(--transition);
    }
    .account-card:hover::after { opacity: 1; }

    /* ── Empty State ── */
    .empty-state {
      text-align: center;
      padding: 60px 24px;
      background: rgba(255,255,255,0.02);
      border: 1px dashed rgba(255,255,255,0.1);
      border-radius: var(--radius-xl);
      animation: fadeInUp 0.5s ease-out both;
    }
    .empty-icon {
      font-size: 3rem;
      margin-bottom: 16px;
      opacity: 0.6;
    }
    .empty-state h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .empty-state p {
      color: var(--text-secondary);
      font-size: 0.92rem;
      margin-bottom: 24px;
    }

    /* ── Quick Actions ── */
    .quick-actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .quick-action-card {
      flex: 1;
      min-width: 200px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: var(--transition);
      cursor: pointer;
      text-decoration: none;
      animation: fadeInUp 0.5s 0.2s ease-out both;
    }
    .quick-action-card:hover {
      background: rgba(255,255,255,0.06);
      transform: translateY(-3px);
      border-color: rgba(255,255,255,0.12);
    }
    .qa-icon {
      width: 44px; height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .qa-icon-transfer { background: rgba(0,210,255,0.1); }
    .qa-icon-account { background: rgba(123,47,247,0.1); }
    .qa-title { font-weight: 600; font-size: 0.92rem; }
    .qa-desc { font-size: 0.8rem; color: var(--text-muted); }

    @media (max-width: 640px) {
      .welcome-banner { padding: 24px; }
      .welcome-text h1 { font-size: 1.3rem; }
      .accounts-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="bg-scene">
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
  </div>

  <div class="page-wrap">
    <%- include('partials/navbar') %>

    <div class="dash-content">

      <!-- Welcome -->
      <div class="welcome-banner">
        <div class="welcome-text">
          <h1>Welcome back, <span class="gradient-text"><%= user.name %></span></h1>
          <p>Here's an overview of your accounts and finances.</p>
        </div>
        <a href="/transfer" class="btn btn-primary">Send Money</a>
      </div>

      <!-- Accounts -->
      <div class="section-header">
        <h2>Your Accounts</h2>
        <form action="/accounts/create" method="POST" style="margin:0;">
          <button type="submit" class="btn btn-secondary" style="padding:10px 22px; font-size:0.88rem;">+ New Account</button>
        </form>
      </div>

      <% if (accounts && accounts.length > 0) { %>
        <div class="accounts-grid">
          <% accounts.forEach(function(acc, idx) { %>
            <div class="account-card" style="animation-delay: <%= idx * 0.1 %>s">
              <div class="account-card-top">
                <span class="account-id" title="<%= acc._id %>">
                  #<%= String(acc._id).slice(-8).toUpperCase() %>
                </span>
                <span class="account-status status-<%= acc.status %>"><%= acc.status %></span>
              </div>
              <div class="account-balance">
                <div class="balance-label">Available Balance</div>
                <div class="balance-value <%= acc.balance > 0 ? 'balance-positive' : (acc.balance < 0 ? 'balance-negative' : 'balance-zero') %>">
                  <%= acc.currency === 'INR' ? '₹' : '$' %><%= Number(acc.balance).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </div>
              </div>
              <div class="account-currency">Currency: <%= acc.currency %></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">🏦</div>
          <h3>No Accounts Yet</h3>
          <p>Create your first account to start banking with Bankify.</p>
          <form action="/accounts/create" method="POST">
            <button type="submit" class="btn btn-primary">Create First Account</button>
          </form>
        </div>
      <% } %>

      <!-- Quick Actions -->
      <div class="section-header" style="margin-top: 16px;">
        <h2>Quick Actions</h2>
      </div>
      <div class="quick-actions">
        <a href="/transfer" class="quick-action-card">
          <div class="qa-icon qa-icon-transfer">💸</div>
          <div>
            <div class="qa-title">Transfer Money</div>
            <div class="qa-desc">Send funds to another account</div>
          </div>
        </a>
        <form action="/accounts/create" method="POST" class="quick-action-card" style="border:none; background:rgba(255,255,255,0.03); cursor:pointer;" onsubmit="return true;">
          <div class="qa-icon qa-icon-account">🏦</div>
          <div>
            <div class="qa-title">Open Account</div>
            <div class="qa-desc">Create a new bank account</div>
          </div>
          <button type="submit" style="position:absolute;inset:0;opacity:0;cursor:pointer;border:none;"></button>
        </form>
      </div>

    </div>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
