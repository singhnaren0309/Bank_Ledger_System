<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .page-wrap {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ── Hero ── */
    .hero {
      padding: 160px 24px 100px;
      text-align: center;
      position: relative;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 20px;
      background: rgba(123,47,247,0.12);
      border: 1px solid rgba(123,47,247,0.25);
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 600;
      color: #b794f6;
      margin-bottom: 28px;
      letter-spacing: 0.03em;
    }
    .hero-badge .dot {
      width: 6px; height: 6px;
      background: var(--accent-cyan);
      border-radius: 50%;
      animation: pulse-ring 2s ease-in-out infinite;
    }
    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4.2rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
      max-width: 800px;
      margin: 0 auto 24px;
    }
    .hero-sub {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: var(--text-secondary);
      max-width: 540px;
      margin: 0 auto 44px;
      line-height: 1.7;
    }
    .hero-buttons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    /* ── Features ── */
    .features {
      padding: 80px 24px 100px;
    }
    .features-heading {
      text-align: center;
      margin-bottom: 56px;
    }
    .features-heading h2 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .features-heading p {
      color: var(--text-secondary);
      font-size: 1.05rem;
    }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
      max-width: 1000px;
      margin: 0 auto;
    }
    .feature-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: var(--radius-xl);
      padding: 36px 32px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }
    .feature-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--accent-gradient);
      opacity: 0;
      transition: var(--transition);
    }
    .feature-card:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(255,255,255,0.12);
      transform: translateY(-6px);
      box-shadow: 0 16px 48px rgba(0,0,0,0.35), var(--shadow-glow);
    }
    .feature-card:hover::before { opacity: 1; }
    .feature-icon {
      width: 56px; height: 56px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 20px;
    }
    .feature-icon-1 { background: rgba(0,210,255,0.1); color: var(--accent-cyan); }
    .feature-icon-2 { background: rgba(123,47,247,0.12); color: #b794f6; }
    .feature-icon-3 { background: rgba(0,230,118,0.1); color: var(--success); }
    .feature-card h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 10px;
      letter-spacing: -0.01em;
    }
    .feature-card p {
      color: var(--text-secondary);
      font-size: 0.92rem;
      line-height: 1.65;
    }

    /* ── Stats ── */
    .stats {
      padding: 60px 24px 80px;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 24px;
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }
    .stat-item {
      padding: 28px 20px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: var(--radius-lg);
      transition: var(--transition);
    }
    .stat-item:hover {
      background: rgba(255,255,255,0.05);
      transform: translateY(-3px);
    }
    .stat-value {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 6px;
    }
    .stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* ── Bottom CTA ── */
    .cta-section {
      padding: 80px 24px 100px;
      text-align: center;
    }
    .cta-card {
      max-width: 600px;
      margin: 0 auto;
      padding: 56px 40px;
      background: rgba(123,47,247,0.06);
      border: 1px solid rgba(123,47,247,0.15);
      border-radius: var(--radius-xl);
      position: relative;
      overflow: hidden;
    }
    .cta-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 60%, rgba(123,47,247,0.08));
      pointer-events: none;
    }
    .cta-card h2 {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 14px;
      letter-spacing: -0.02em;
      position: relative;
      z-index: 1;
    }
    .cta-card p {
      color: var(--text-secondary);
      margin-bottom: 32px;
      font-size: 1.02rem;
      position: relative;
      z-index: 1;
    }
    .cta-card .btn { position: relative; z-index: 1; }
  </style>
</head>
<body>
  <div class="bg-scene">
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-orb bg-orb-3"></div>
  </div>

  <div class="page-wrap">
    <%- include('partials/navbar') %>

    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-badge anim-fade-up"><span class="dot"></span> Next-Gen Digital Banking</div>
        <h1 class="anim-fade-up-2">
          Banking Made<br><span class="gradient-text">Effortlessly Modern</span>
        </h1>
        <p class="hero-sub anim-fade-up-3">
          Transfer money instantly, track balances in real time, and manage your accounts — all from one secure platform.
        </p>
        <div class="hero-buttons anim-fade-up-4">
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
          <% } else { %>
            <a href="/register" class="btn btn-primary">Create Free Account</a>
            <a href="/login" class="btn btn-ghost">Sign In</a>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="container">
        <div class="features-heading anim-fade-up">
          <h2>Why Choose <span class="gradient-text">Bankify</span></h2>
          <p>Everything you need for modern banking, nothing you don't.</p>
        </div>
        <div class="features-grid">
          <div class="feature-card anim-fade-up-2">
            <div class="feature-icon feature-icon-1">⚡</div>
            <h3>Instant Transfers</h3>
            <p>Send money to any account in seconds. Idempotent, ledger-backed transactions you can trust.</p>
          </div>
          <div class="feature-card anim-fade-up-3">
            <div class="feature-icon feature-icon-2">📊</div>
            <h3>Smart Dashboard</h3>
            <p>Real-time balances, account status, and a bird's-eye view of all your finances in one place.</p>
          </div>
          <div class="feature-card anim-fade-up-4">
            <div class="feature-icon feature-icon-3">🔐</div>
            <h3>Bank-Grade Security</h3>
            <p>JWT authentication, encrypted passwords, and immutable ledger entries keep your money safe.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats">
      <div class="stats-grid anim-fade-up">
        <div class="stat-item">
          <div class="stat-value gradient-text">10K+</div>
          <div class="stat-label">Transactions</div>
        </div>
        <div class="stat-item">
          <div class="stat-value gradient-text">99.9%</div>
          <div class="stat-label">Uptime</div>
        </div>
        <div class="stat-item">
          <div class="stat-value gradient-text">256-bit</div>
          <div class="stat-label">Encryption</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-card anim-fade-up">
        <h2>Ready to Get Started?</h2>
        <p>Join thousands who already trust Bankify for their everyday banking.</p>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-primary">Open Dashboard</a>
        <% } else { %>
          <a href="/register" class="btn btn-primary">Create Your Account</a>
        <% } %>
      </div>
    </section>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
